{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2024.Promise"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@openchamber/ui/*": ["../ui/src/*"],
      "@/*": ["../ui/src/*"]
    }
  },
  "include": ["src"]
}
